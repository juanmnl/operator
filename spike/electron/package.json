{
  "name": "operator-electron-shell",
  "private": true,
  "version": "0.17.0-alpha.2",
  "description": "Operator — mission control for working agents. Electron shell.",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "../../node_modules/.bin/vite build --config vite.config.ts",
    "build": "npm run build:main && npm run build:renderer",
    "postinstall": "electron-rebuild -f -w node-pty,better-sqlite3",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.7.0",
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "electron": "^43.4.1",
    "esbuild": "^0.27.7",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "yaml": "^2.9.0"
  },
  "productName": "Operator"
}
