{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Operator",
  "version": "0.1.0",
  "identifier": "com.operator.app.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Operator",
        "width": 1100,
        "height": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Juan Cornejo (UJS4C5GUCW)",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
