{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Operator",
  "version": "0.5.0",
  "identifier": "com.operator.app.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Operator",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0b0d10",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/juanmnl/operator-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZENEE0OEY2MEIwOENGNDEKUldSQnp3Z0w5a2hLL2V2UUpOL3VWOEhURTkwOTdrMFJtZGpXVmV1bHFFSEJwMm96Mm1zSUl3aWoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Juan Cornejo (UJS4C5GUCW)",
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
