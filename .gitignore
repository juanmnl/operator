# No trailing slash, deliberately. `node_modules/` matches a DIRECTORY only, so a worktree that
# symlinks its deps (`ln -s .../node_modules node_modules`) leaves an entry git does NOT ignore
# and `git add -A` will happily commit it — which is how an absolute, machine-specific symlink
# into one developer's home directory reached main and then fought the real install on checkout.
node_modules
out/
dist/
release/
.DS_Store

# Visual-verification screenshots (scripts/visual/capture.mjs)
scripts/visual/out/

# Width-audit replay capture (regenerable via scripts/width-audit/capture-claude.py)
scripts/width-audit/claude-stream.bin

# Claude Code local config (never commit — repo is public)
.claude/
